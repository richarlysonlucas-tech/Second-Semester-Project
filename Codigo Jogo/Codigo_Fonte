import java.util.Scanner;

public class SistemaBatalha {

    public static void main(String[] args) {

        Scanner scanner = new Scanner(System.in);

        Personagem jogador = new Personagem();

        System.out.print("Digite o nome do seu personagem: ");
        jogador.nome = scanner.nextLine();

        System.out.println("\n==============================");
        System.out.println("       ESCOLHA SUA CLASSE");
        System.out.println("==============================\n");

        System.out.println("1 - Guerreiro");
        System.out.println("2 - Mago");
        System.out.println("3 - Arqueiro");

        System.out.print("\nEscolha sua classe: ");
        int escolha = scanner.nextInt();

        switch (escolha) {

            case 1:
                jogador.vida = 120;
                jogador.força = 20;
                jogador.velocidade = 7;
                jogador.precisao = 7;
                jogador.magia = 2;
                break;

            case 2:
                jogador.vida = 80;
                jogador.força = 5;
                jogador.velocidade = 8;
                jogador.precisao = 8;
                jogador.magia = 20;
                break;

            case 3:
                jogador.vida = 90;
                jogador.força = 12;
                jogador.velocidade = 15;
                jogador.precisao = 12;
                jogador.magia = 5;
                break;

            case 4:
                jogador.vida = 100;
                jogador.força = 13;
                jogador.velocidade = 12;
                jogador.precisao = 18;
                jogador.magia = 4;
                break;

            default:
                System.out.println("Opção inválida!");
                scanner.close();
                return;
        }

        System.out.println("\n==============================");
        System.out.println("        SEU PERSONAGEM");
        System.out.println("==============================\n");

        System.out.println("Nome: " + jogador.nome);
        System.out.println("Vida: " + jogador.vida);
        System.out.println("Força: " + jogador.força);
        System.out.println("Velocidade: " + jogador.velocidade);
        System.out.println("Precisão: " + jogador.precisao);
        System.out.println("Magia: " + jogador.magia);

        // INIMIGO
        System.out.println("\n==============================");
        System.out.println("           INIMIGO");
        System.out.println("==============================");

        System.out.println("Goblin");
        System.out.println("Vida: 80");
        System.out.println("Força: 12");
        System.out.println("Velocidade: 7");
        System.out.println("Precisão: 5");
        System.out.println("Magia: 3");

        // BATALHA
        System.out.println("\n==============================");
        System.out.println("           BATALHA");
        System.out.println("==============================\n");

        System.out.println(
                "O jogador " + jogador.nome
                + " inicia a batalha com o inimigo Goblin!"
        );

        System.out.println("\nEscolha Seu Ataque:");
        System.out.println("1 - Ataque Normal");
        System.out.println("2 - Ataque Especial");
        System.out.print("Opção: ");

        int escolhaAtaque = scanner.nextInt();

        switch (escolhaAtaque) {

            case 1:
                System.out.println(
                        "\n" + jogador.nome + " usou Ataque Normal!"
                );

                System.out.println(
                        "O inimigo Goblin recebeu "
                        + jogador.força
                        + " de dano!"
                );
                break;

            case 2:
                System.out.println(
                        "\n" + jogador.nome + " usou Ataque Especial!"
                );

                System.out.println(
                        "O inimigo Goblin recebeu "
                        + jogador.magia
                        + " de dano!"
                );
                break;

            default:
                System.out.println("Digite 1 ou 2!");
                scanner.close();
                return;
        }

        // CONTRA-ATAQUE
        System.out.println("\n==============================");
        System.out.println("       CONTRA-ATAQUE");
        System.out.println("==============================\n");

        System.out.println("Goblin contra-ataca!");
        System.out.println("O inimigo Goblin usou Ataque Normal!");
        System.out.println(
                jogador.nome + " recebeu 12 de dano!"
        );

        scanner.close();
    }
}
